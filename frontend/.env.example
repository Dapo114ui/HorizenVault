# All three are read at BUILD time and compiled into the browser bundle --
# changing one needs a rebuild, and none of them is a secret.

# --- Against X1 EcoChain's Maculatus testnet (what Vercel is set to) ---
# See docs/DEPLOYMENTS.md for the deployed addresses.
#   NEXT_PUBLIC_CHAIN_ID=10778
#   NEXT_PUBLIC_RPC_URL=https://maculatus-rpc.x1eco.com
#   NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=0x76830898D4deC2E2D71055a553896FDECA29B070

# --- Against a local Hardhat node (see repo root README) ---
#   npx hardhat node
#   npx hardhat run scripts/deploy-local.js --network localhost
# That script prints exactly these three lines, filled in.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=

# Leaving NEXT_PUBLIC_VAULT_FACTORY_ADDRESS empty puts the app in its
# labelled preview mode: sample vaults, every write action disabled.
